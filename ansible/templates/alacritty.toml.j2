general.import = ["~/.config/alacritty/themes/themes/kanagawa_dragon.toml"]
general.live_config_reload = true

[env]
TERM = "xterm-256color"

# Window customization for cleaner look
[window]
padding = { x = 10, y = 15 }
decorations = "full"
dynamic_padding = true
startup_mode = "Maximized"
dynamic_title = true
opacity = 1.0

[font]
normal = { family = "FiraCode Nerd Font", style = "Regular" }
size = 11.0

[cursor]
style = { shape = "Block", blinking = "Always" }
vi_mode_style = { shape = "Block", blinking = "Always" }
blink_interval = 750

[scrolling]
history = 10000
multiplier = 3

[mouse]
hide_when_typing = true

[terminal.shell]
program = "{{ zsh_path.stdout }}"
args = ["-l", "-c", "tmux attach || tmux"]

[[keyboard.bindings]]
key = "V"
mods = "Alt|Shift"
action = "Paste"

[[keyboard.bindings]]
key = "C"
mods = "Alt|Shift"
action = "Copy"

[selection]
save_to_clipboard = true
